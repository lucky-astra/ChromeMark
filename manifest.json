{
  "manifest_version": 3,
  "name": "ChromeMark · 图文收藏",
  "version": "1.0.0",
  "description": "把网页里的好句子和好图片，收进自己的灵感库。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "contextMenus", "sidePanel", "activeTab", "scripting", "clipboardWrite"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 ChromeMark 素材库", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "quick-open": {
      "suggested_key": { "default": "Alt+M", "mac": "Alt+M" },
      "description": "打开 ChromeMark 快速调用面板"
    }
  }
}
